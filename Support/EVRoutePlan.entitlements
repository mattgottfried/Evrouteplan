<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ============================================================
	     OPTIONAL CAPABILITIES — commented out so the app signs with
	     ZERO developer-portal setup. The app runs fine without them:
	     weather adjustment quietly turns off, and the home-screen
	     widget shows "open the app" until the App Group exists.

	     To enable, do the portal steps below, wait ~30 minutes for
	     propagation, then uncomment and rebuild.

	     1. WeatherKit (weather-adjusted range):
	        developer.apple.com → Identifiers → com.mattgottfried.EVRoutePlan
	        → tick WeatherKit on BOTH the Capabilities and App Services
	        tabs → Save. Then uncomment:

	<key>com.apple.developer.weatherkit</key>
	<true/>

	     2. App Group (feeds the home-screen battery widget):
	        developer.apple.com → Identifiers → App Groups → + →
	        register group.com.mattgottfried.EVRoutePlan, then enable it
	        on BOTH the app ID and the ChargingWidget ID. Then uncomment
	        here AND in Support/ChargingWidget.entitlements:

	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.mattgottfried.EVRoutePlan</string>
	</array>
	     ============================================================ -->
	<!--
	CarPlay: after Apple approves your "EV charging app" CarPlay entitlement
	request (see README step 5), uncomment the two lines below. Building with
	them BEFORE approval makes code signing fail, so they ship commented out.

	<key>com.apple.developer.carplay-charging</key>
	<true/>
	-->
</dict>
</plist>
